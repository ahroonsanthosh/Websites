---
interface Props {
  class?: string;
  label?: string;
  sub?: string;
}
const { class: className = "", label = "Some Dose", sub = "Est. 2020 · Cork" } = Astro.props;
const id = `badge-arc-${Math.random().toString(36).slice(2, 9)}`;
---

<svg
  class={`wave-badge ${className}`}
  viewBox="0 0 200 200"
  role="img"
  aria-label={`${label}, ${sub}`}
>
  <defs>
    <path id={id} d="M 22,100 A 78,78 0 0 1 178,100" />
  </defs>
  <circle cx="100" cy="100" r="97" fill="var(--paper)" stroke="currentColor" stroke-width="2"></circle>
  <circle cx="100" cy="100" r="86" fill="none" stroke="currentColor" stroke-width="1" stroke-dasharray="2 6"></circle>
  <text font-family="var(--font-mono)" font-size="13" letter-spacing="3" fill="currentColor" text-anchor="middle">
    <textPath href={`#${id}`} startOffset="50%">{label.toUpperCase()}</textPath>
  </text>
  <g transform="translate(100 112)">
    <path
      d="M -34 4 C -20 -20, -2 -20, 12 0 C 24 16, 36 16, 40 6"
      fill="none"
      stroke="var(--teal-500)"
      stroke-width="7"
      stroke-linecap="round"
    ></path>
    <circle cx="26" cy="-16" r="15" fill="var(--blush-300)"></circle>
  </g>
  <text
    x="100"
    y="152"
    text-anchor="middle"
    font-family="var(--font-mono)"
    font-size="10.5"
    letter-spacing="2"
    fill="currentColor"
  >{sub.toUpperCase()}</text>
</svg>

<style>
  .wave-badge {
    width: 100%;
    height: auto;
    color: var(--navy-900);
  }
</style>
