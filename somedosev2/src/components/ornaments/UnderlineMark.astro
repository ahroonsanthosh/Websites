---
interface Props {
  class?: string;
  color?: string;
}
const { class: className = "", color = "currentColor" } = Astro.props;
---

<svg
  class={`underline-mark ${className}`}
  viewBox="0 0 220 20"
  preserveAspectRatio="none"
  aria-hidden="true"
  focusable="false"
  style={`color:${color}`}
>
  <path
    class="underline-mark__stroke"
    d="M3 14 C 40 4, 80 20, 120 10 C 150 3, 180 15, 217 7"
    fill="none"
    stroke="currentColor"
    stroke-width="6"
    stroke-linecap="round"
  ></path>
</svg>

<style>
  .underline-mark {
    display: inline-block;
    width: 100%;
    height: 0.5em;
    overflow: visible;
  }
  .underline-mark__stroke {
    stroke-dasharray: 320;
    stroke-dashoffset: 320;
    transition: stroke-dashoffset 700ms var(--ease-entrance) 120ms;
  }
  .is-visible .underline-mark__stroke {
    stroke-dashoffset: 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .underline-mark__stroke { stroke-dashoffset: 0 !important; transition: none; }
  }
</style>
