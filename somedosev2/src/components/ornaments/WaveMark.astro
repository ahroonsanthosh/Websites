---
interface Props {
  class?: string;
  size?: string;
}
const { class: className = "", size = "2.1rem" } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 60 60"
  role="img"
  aria-label="Some Dose wave mark"
  width={size}
  height={size}
  style={`width:${size}; height:${size}; display:block; flex-shrink:0;`}
>
  <circle cx="30" cy="30" r="29" fill="var(--paper)" stroke="currentColor" stroke-width="1.5" opacity="0.5"></circle>
  <circle cx="38" cy="21" r="10.5" fill="var(--blush-300)"></circle>
  <path
    d="M 12 34 C 18 20, 30 20, 36 30 C 40 37, 46 37, 48 32"
    fill="none"
    stroke="var(--teal-500)"
    stroke-width="6"
    stroke-linecap="round"
  ></path>
</svg>
