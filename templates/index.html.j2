<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Balance — Cafe & Deli, Glanmire, Cork | Food to Make you Feel Good</title>
<meta name="description" content="Balance is a scratch-made neighbourhood cafe in Riverstown, Glanmire, Cork — known for its full Irish breakfast and homemade bread. Open Mon–Sat.">
<link rel="canonical" href="{{ site_url }}">
<meta property="og:type" content="restaurant">
<meta property="og:title" content="Balance — Food to Make you Feel Good">
<meta property="og:description" content="Scratch-made cafe & deli in Riverstown, Glanmire, Cork. Famous for the full breakfast and homemade bread.">
<meta property="og:image" content="{{ site_url }}assets/images/og-image.jpg">
<meta property="og:url" content="{{ site_url }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="theme-color" content="#faf6ee">
<link rel="icon" href="./favicon.svg" type="image/svg+xml">
<link rel="preload" as="font" href="./assets/fonts/fraunces-display.woff2" type="font/woff2" crossorigin>
<link rel="preload" as="font" href="./assets/fonts/fraunces-text.woff2" type="font/woff2" crossorigin>
<link rel="preload" as="image" href="./assets/images/storefront-mobile-960.webp" imagesrcset="./assets/images/storefront-mobile-480.webp 480w, ./assets/images/storefront-mobile-750.webp 750w, ./assets/images/storefront-mobile-960.webp 960w" media="(max-width: 760px)">
<link rel="preload" as="image" href="./assets/images/storefront-1920.webp" imagesrcset="./assets/images/storefront-960.webp 960w, ./assets/images/storefront-1280.webp 1280w, ./assets/images/storefront-1920.webp 1920w" media="(min-width: 761px)">
<link rel="stylesheet" href="./css/style.css">
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "CafeOrCoffeeShop",
  "name": "{{ b.name }}",
  "image": "{{ site_url }}assets/images/storefront-1280.jpg",
  "servesCuisine": "Cafe, Breakfast, Deli",
  "priceRange": "{{ b.priceRange }}",
  "telephone": "{{ b.phone }}",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "{{ b.address.line1 }}, {{ b.address.line2 }}",
    "addressLocality": "{{ b.address.city }}",
    "postalCode": "{{ b.address.postcode }}",
    "addressCountry": "{{ b.address.country }}"
  },
  "geo": { "@type": "GeoCoordinates", "latitude": {{ b.geo.lat }}, "longitude": {{ b.geo.lng }} },
  "url": "{{ site_url }}",
  "sameAs": ["{{ b.social.instagram }}", "{{ b.social.facebook }}"],
  "openingHoursSpecification": [
    { "@type": "OpeningHoursSpecification", "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday"], "opens": "08:15", "closes": "16:00" },
    { "@type": "OpeningHoursSpecification", "dayOfWeek": "Saturday", "opens": "09:00", "closes": "15:30" }
  ],
  "menu": "{{ site_url }}#menu"
}
</script>
</head>
<body>
<script>document.documentElement.classList.add("js")</script>
<noscript><style>.preloader{ display: none !important; }</style></noscript>
<a class="skip-link" href="#main">Skip to content</a>

<svg class="visually-hidden" aria-hidden="true">
  <symbol id="icon-phone" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 4h3l2 5-2.5 1.5a11 11 0 0 0 5 5L14 13l5 2v3a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2Z"/></symbol>
  <symbol id="icon-pin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s7-6.3 7-12a7 7 0 1 0-14 0c0 5.7 7 12 7 12Z"/><circle cx="12" cy="9" r="2.4"/></symbol>
  <symbol id="icon-instagram" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r="1"/></symbol>
  <symbol id="icon-facebook" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 21v-7h2.3l.4-3H14.5V9c0-.9.3-1.5 1.7-1.5h1.6V4.8c-.3 0-1.2-.1-2.3-.1-2.3 0-3.9 1.4-3.9 4v2.2H9.5v3h2.1v7h2.9Z"/></symbol>
  <symbol id="icon-home" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="m4 11 8-7 8 7"/><path d="M6 10v9h12v-9"/></symbol>
  <symbol id="icon-menu" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M6 8h12M6 12h12M6 16h8"/></symbol>
  <symbol id="icon-photo" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3.5" y="5" width="17" height="14" rx="2"/><circle cx="9" cy="10.5" r="1.6"/><path d="m5 17 4.5-4.5 3 3L18 10l1.5 1.5"/></symbol>
  <symbol id="icon-cup" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 8h11v6a5 5 0 0 1-5 5H9a4 4 0 0 1-4-4V8Z"/><path d="M16 9.5h1.5a2.5 2.5 0 0 1 0 5H16"/><path d="M8 3.5c-.6.8-.6 1.4 0 2.2M11.5 3.5c-.6.8-.6 1.4 0 2.2"/></symbol>
  <symbol id="icon-leaf" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 19c0-8 4-13.5 14-13.5C19 15 13.5 19 5 19Z"/><path d="M6 18C11 13 14 10 17.5 6.7"/></symbol>
</svg>

<div class="preloader" aria-hidden="true">
  <svg class="preloader-mark" viewBox="{{ heart_viewbox }}"><g transform="{{ heart_transform }}" fill="currentColor"><path d="{{ heart_path }}"/></g></svg>
  <span class="preloader-count mono">Balance</span>
</div>

<header class="site-header">
  <div class="wrap nav-row">
    <a href="#top" aria-label="Balance — home">
      <svg class="nav-mark" viewBox="{{ heart_viewbox }}"><g transform="{{ heart_transform }}" fill="currentColor"><path d="{{ heart_path }}"/></g></svg>
    </a>
    <nav class="nav-links" aria-label="Primary">
      <a href="#about">About</a>
      <a href="#menu">Menu</a>
      <a href="#gallery">Gallery</a>
      <a href="#reviews">Reviews</a>
      <a href="#visit">Visit</a>
    </nav>
    <a class="btn btn-line nav-call" href="tel:{{ b.phone }}">
      <svg class="btn-icon" aria-hidden="true"><use href="#icon-phone"/></svg>{{ b.phoneDisplay }}
    </a>
  </div>
</header>

<nav class="pill-nav" aria-label="Quick links">
  <a href="#top" aria-label="Home"><svg aria-hidden="true"><use href="#icon-home"/></svg></a>
  <a href="#menu" aria-label="Menu"><svg aria-hidden="true"><use href="#icon-menu"/></svg></a>
  <a href="#gallery" aria-label="Gallery"><svg aria-hidden="true"><use href="#icon-photo"/></svg></a>
  <a class="is-cta" href="tel:{{ b.phone }}" aria-label="Call Balance"><svg aria-hidden="true"><use href="#icon-phone"/></svg></a>
</nav>

<main id="main">
<section class="hero" id="top">
  <div class="hero-media">
    <picture>
      <source media="(max-width: 760px)" srcset="./assets/images/storefront-mobile-480.webp 480w, ./assets/images/storefront-mobile-750.webp 750w, ./assets/images/storefront-mobile-960.webp 960w" type="image/webp">
      <source srcset="./assets/images/storefront-960.webp 960w, ./assets/images/storefront-1280.webp 1280w, ./assets/images/storefront-1920.webp 1920w" type="image/webp">
      <img src="./assets/images/storefront-1280.jpg" srcset="./assets/images/storefront-960.jpg 960w, ./assets/images/storefront-1280.jpg 1280w, ./assets/images/storefront-1920.jpg 1920w" sizes="100vw" width="1360" height="1007" alt="Balance cafe shopfront on Old Court in Riverstown, Glanmire, with outdoor seating" fetchpriority="high">
    </picture>
    <div class="hero-scrim"></div>
  </div>

  <div class="float-icon" style="top:22%; left:8%; width:3rem; height:3rem;" aria-hidden="true">
    <svg viewBox="{{ heart_viewbox }}"><g transform="{{ heart_transform }}" fill="currentColor"><path d="{{ heart_path }}"/></g></svg>
  </div>
  <div class="float-icon" style="top:34%; right:10%; width:2.4rem; height:2.4rem;" aria-hidden="true">
    <svg viewBox="0 0 24 24"><use href="#icon-cup" stroke="currentColor" fill="none" stroke-width="1.6"/></svg>
  </div>
  <div class="float-icon" style="top:60%; right:20%; width:2rem; height:2rem;" aria-hidden="true">
    <svg viewBox="0 0 24 24"><use href="#icon-leaf" stroke="currentColor" fill="none" stroke-width="1.6"/></svg>
  </div>

  <div class="hero-inner">
    <span class="eyebrow hero-eyebrow">{{ b.address.line2 }}, Cork</span>
    <h1 class="hero-title">
      <span class="line"><span>Food to make</span></span>
      <span class="line"><span>you feel good.</span></span>
    </h1>
    <p class="hero-sub">{{ differentiator }}</p>
    <dl class="hero-meta">
      <dl><dt>Hours</dt><dd>Mon–Fri 8:15–4 · Sat 9–3:30</dd></dl>
      <dl><dt>Phone</dt><dd>{{ b.phoneDisplay }}</dd></dl>
      <dl><dt>Since</dt><dd>Sit in or take away</dd></dl>
    </dl>
    <div class="hero-cta">
      <a class="btn btn-fill" href="tel:{{ b.phone }}"><svg class="btn-icon" aria-hidden="true"><use href="#icon-phone"/></svg>Call to order</a>
      <a class="btn" style="color:var(--cream-50); border-color:rgba(250,246,238,.6);" href="https://www.google.com/maps/search/?api=1&query={{ b.address.line1 }}+{{ b.address.line2 }}+{{ b.address.city }}+{{ b.address.postcode }}" target="_blank" rel="noopener"><svg class="btn-icon" aria-hidden="true"><use href="#icon-pin"/></svg>Get directions</a>
    </div>
  </div>

  <div class="scroll-cue"><span>Scroll</span><span class="line"></span></div>
</section>

<div class="marquee-band">
  <div class="marquee-track">
    <span>Scratch made daily</span>
    <span>Full Irish breakfast</span>
    <span>Homemade bread</span>
    <span>Sit in or take away</span>
    <span>Riverstown, Glanmire</span>
  </div>
</div>

<section class="section about gradient-field" id="about">
  <div class="wrap about-grid">
    <div class="about-copy" data-reveal>
      <svg class="about-heart" viewBox="{{ heart_viewbox }}" aria-hidden="true"><g transform="{{ heart_transform }}" fill="currentColor"><path d="{{ heart_path }}"/></g></svg>
      <span class="progress-index">01 / About</span>
      <h2>Not a wellness gimmick.<br>Just properly made food.</h2>
      <svg class="squiggle draw-on" viewBox="0 0 220 24" aria-hidden="true">
        <path d="M4 14c14-12 28-12 40 0s28 12 40 0 28-12 40 0 28 12 40 0 24-10 40-2" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round"/>
      </svg>
      <p class="lede">{{ differentiator }}</p>
      <p>Everything on the counter — the bread, the compotes, the granola — is made in the kitchen upstairs, not shipped in. Regulars come for the full breakfast; they stay for the bread underneath it.</p>
      <div class="about-facts">
        <div class="fact"><strong>€14.00</strong><span>Full Balance breakfast</span></div>
        <div class="fact"><strong>8:15am</strong><span>Doors open Mon&ndash;Fri</span></div>
        <div class="fact"><strong>Closed</strong><span>Sundays, always</span></div>
      </div>
    </div>
    <div class="about-media" data-reveal>
      <div class="frame">
        <img src="./assets/images/full-breakfast-720.webp" srcset="./assets/images/full-breakfast-480.webp 480w, ./assets/images/full-breakfast-720.webp 720w, ./assets/images/full-breakfast-960.webp 960w" sizes="(min-width: 900px) 34vw, 80vw" width="765" height="1020" loading="lazy" alt="Balance full breakfast with bacon, black pudding, roast potatoes and coleslaw on a wooden table">
        <span class="about-tag script" aria-hidden="true">the one to order</span>
      </div>
      <svg class="about-badge" viewBox="0 0 200 200" aria-hidden="true">
        <circle cx="100" cy="100" r="98" fill="var(--cream-50)"/>
        <g class="ring">
          <defs><path id="badgeCircle" d="M100,100 m-78,0 a78,78 0 1,1 156,0 a78,78 0 1,1 -156,0"/></defs>
          <text font-family="Space Mono, monospace" font-size="11.5" letter-spacing="2" fill="currentColor">
            <textPath href="#badgeCircle" startOffset="0%">FRESH DAILY &#8226; HOMEMADE &#8226; FRESH DAILY &#8226; HOMEMADE &#8226;</textPath>
          </text>
        </g>
        <g transform="translate(72,72) scale(0.13)" fill="currentColor"><g transform="{{ heart_transform }}"><path d="{{ heart_path }}"/></g></g>
      </svg>
    </div>
  </div>
</section>

<section class="section menu-section gradient-field" id="menu">
  <div class="wrap">
    <div class="section-head" data-reveal>
      <span class="progress-index">02 / Menu</span>
      <h2>What's actually on the counter</h2>
      <p class="lede">{{ menu.note }}</p>
    </div>

    <div class="menu-tabs" role="tablist" aria-label="Menu categories" data-reveal>
      <span class="menu-tab-indicator" aria-hidden="true"></span>
      {% for sec in menu.sections %}
      <button class="menu-tab" role="tab" id="tab-{{ sec.id }}" aria-controls="panel-{{ sec.id }}" aria-selected="{{ 'true' if loop.first else 'false' }}">{{ sec.title }}</button>
      {% endfor %}
    </div>

    <div class="menu-panels">
      {% for sec in menu.sections %}
      <div class="menu-panel{{ ' is-active' if loop.first else '' }}" id="panel-{{ sec.id }}" role="tabpanel" aria-labelledby="tab-{{ sec.id }}">
        <div class="menu-list">
          {% for item in sec['items'] %}
          <div class="menu-item{{ ' is-signature' if item.signature else '' }}">
            <span class="menu-item-name">{{ item.name }}{% if item.note %}<span class="menu-item-note">{{ item.note }}</span>{% endif %}</span>
            <span class="menu-item-price mono">{{ item.price or '' }}</span>
          </div>
          {% endfor %}
        </div>
        {% if sec.addOns %}<p class="menu-addons">{{ sec.addOns }}</p>{% endif %}
      </div>
      {% endfor %}
    </div>
  </div>
</section>

<section class="section gallery-section gradient-field" id="gallery">
  <div class="gallery-rail-viewport wrap">
    <div class="section-head" data-reveal>
      <span class="progress-index">03 / Gallery</span>
      <h2>From the kitchen this week</h2>
    </div>
    <div class="gallery-rail">
      {% for g in gallery %}
      <figure class="gallery-card">
        <img src="./assets/images/{{ g.image }}-720.webp" srcset="./assets/images/{{ g.image }}-480.webp 480w, ./assets/images/{{ g.image }}-720.webp 720w, ./assets/images/{{ g.image }}-960.webp 960w" sizes="(min-width: 900px) 24vw, 70vw" width="765" height="1020" loading="lazy" alt="{{ g.alt }}">
        <figcaption class="gallery-caption mono">{{ g.caption }}</figcaption>
      </figure>
      {% endfor %}
    </div>
  </div>
</section>

<section class="section testimonials-section gradient-field" id="reviews">
  <div class="wrap">
    <div class="section-head" data-reveal>
      <span class="progress-index">04 / Reviews</span>
      <h2>What Glanmire says</h2>
      <p class="lede">Real Google reviews, unedited.</p>
    </div>
    <div class="testimonial-stack">
      {% for t in testimonials %}
      <blockquote class="testimonial-card" data-reveal>
        <p class="testimonial-quote">&ldquo;{{ t.quote }}&rdquo;</p>
        <footer class="testimonial-byline">
          <span>{{ t.name }} &middot; {{ t.when }}</span>
          <span class="testimonial-stars" aria-label="{{ t.rating }} out of 5 stars">{{ '★' * t.rating }}{{ '☆' * (5 - t.rating) }}</span>
        </footer>
      </blockquote>
      {% endfor %}
    </div>
  </div>
</section>

<section class="section visit-section gradient-field" id="visit">
  <div class="wrap visit-grid">
    <div data-reveal>
      <span class="progress-index">05 / Visit</span>
      <h2>Find us in Riverstown</h2>
      <div class="address-block" style="margin-top:1.5rem;">
        <address class="lede" style="color:var(--teal-100);">
          {{ b.address.line1 }}, {{ b.address.line2 }}<br>{{ b.address.city }} {{ b.address.postcode }}
        </address>
      </div>
      <ul class="features-tags">
        {% for f in features %}<li>{{ f }}</li>{% endfor %}
      </ul>
    </div>
    <div data-reveal>
      <table class="hours-table">
        {% for h in hours %}
        <tr><td>{{ h.days }}</td><td class="mono">{{ h.time }}</td></tr>
        {% endfor %}
      </table>
      <div class="contact-list">
        <a href="tel:{{ b.phone }}"><svg><use href="#icon-phone"/></svg><span><span class="label">Call</span><span class="value">{{ b.phoneDisplay }}</span></span></a>
        <a href="https://www.google.com/maps/search/?api=1&query={{ b.address.line1 }}+{{ b.address.line2 }}+{{ b.address.city }}+{{ b.address.postcode }}" target="_blank" rel="noopener"><svg><use href="#icon-pin"/></svg><span><span class="label">Directions</span><span class="value">Old Court, Riverstown</span></span></a>
        <a href="{{ b.social.instagram }}" target="_blank" rel="noopener"><svg><use href="#icon-instagram"/></svg><span><span class="label">Instagram</span><span class="value">{{ b.social.instagramHandle }}</span></span></a>
        <a href="{{ b.social.facebook }}" target="_blank" rel="noopener"><svg><use href="#icon-facebook"/></svg><span><span class="label">Facebook</span><span class="value">Food to Make You Feel Good</span></span></a>
      </div>
    </div>
  </div>
</section>
</main>

<footer class="site-footer">
  <div class="wrap footer-top">
    <div class="footer-links">
      <div>
        <h3>Balance</h3>
        <ul>
          <li><a href="#about">About</a></li>
          <li><a href="#menu">Menu</a></li>
          <li><a href="#gallery">Gallery</a></li>
        </ul>
      </div>
      <div>
        <h3>Visit</h3>
        <ul>
          <li><a href="#visit">Hours &amp; address</a></li>
          <li><a href="tel:{{ b.phone }}">{{ b.phoneDisplay }}</a></li>
        </ul>
      </div>
      <div>
        <h3>Follow</h3>
        <ul>
          <li><a href="{{ b.social.instagram }}" target="_blank" rel="noopener">Instagram</a></li>
          <li><a href="{{ b.social.facebook }}" target="_blank" rel="noopener">Facebook</a></li>
        </ul>
      </div>
    </div>
  </div>
  <div class="wrap footer-wordmark">
    <svg viewBox="0 0 720 190"><g transform="translate(0,0)" fill="currentColor">{{ wordmark_group | safe }}</g></svg>
  </div>
  <div class="wrap footer-bottom">
    <span>&copy; {{ year }} Balance District, Riverstown, Glanmire.</span>
    <span>Built with real menus, real reviews, no stock photos.</span>
  </div>
</footer>

<script src="./assets/vendor/gsap.min.js"></script>
<script src="./assets/vendor/ScrollTrigger.min.js"></script>
<script src="./assets/vendor/Draggable.min.js"></script>
<script src="./assets/vendor/lenis.min.js"></script>
<script src="./js/main.js"></script>
</body>
</html>
